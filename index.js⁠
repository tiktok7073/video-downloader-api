const express = require('express');
const cors = require('cors');
const axios = require('axios');

const app = express();
app.use(cors());
app.use(express.json());

app.get('/api/download', async (req, res) => {
  const { url } = req.query;
  if (!url) return res.status(400).json({ error: 'الرابط مطلوب' });

  try {
    const response = await axios.get(`https://api.cobalt.tools/api/json?url=${encodeURIComponent(url)}`, {
      headers: { 'Accept': 'application/json' }
    });
    
    if (response.data && response.data.url) {
      return res.json({ downloadUrl: response.data.url });
    }
    res.status(400).json({ error: 'تعذر جلب رابط التحميل المباشر' });
  } catch (err) {
    res.status(500).json({ error: 'حدث خطأ أثناء معالجة المقطع' });
  }
});

const PORT = process.env.PORT || 3000;
app.listen(PORT, () => console.log(`Server running on port ${PORT}`));
